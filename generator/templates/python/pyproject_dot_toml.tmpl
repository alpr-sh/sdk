[build-system]
requires = ["hatchling>=1.33"]
build-backend = "hatchling.build"

[project]
name = "alpr-sdk"
version = "{{.Version}}"
description = "Alpr.sh's SDK for Python: products, customers, checkouts, payments, subscriptions and webhooks."
readme = "README.md"
license = "MIT"
requires-python = ">=3.11"
dependencies = []
classifiers = [
    "Programming Language :: Python :: 3",
    "Typing :: Typed",
]

[project.urls]
Homepage = "https://alpr.sh"
Repository = "https://github.com/alpr-sh/sdk"

[tool.hatch.build.targets.wheel]
packages = ["src/alpr"]
